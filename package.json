{
  "name": "where-my-hug",
  "version": "0.2.0",
  "description": "Where my hug at? Tell your AI agent what you want a model to do. It finds what Hugging Face already has for it, what to fine-tune, and what's just code, with every model checked live.",
  "license": "MIT",
  "mcpName": "io.github.bikemeardsley/where-my-hug",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bikemeardsley/where-my-hug.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "hugging-face",
    "huggingface",
    "machine-learning",
    "claude-code",
    "agent-skills"
  ],
  "type": "module",
  "bin": {
    "where-my-hug": "build/src/server.js"
  },
  "files": [
    "build/src"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "tsc",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
